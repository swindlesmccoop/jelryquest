# Tailscale (https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-xxxxxxxx
# VPS tailscale machine name or 100.x.x.x address (not public WAN IP)
TS_EXIT_NODE=vps-hostname
# compose sets TS_ACCEPT_DNS=false + 1.1.1.1/8.8.8.8 DNS on the sidecar if resolution fails

# VPS public WAN IP (run on VPS: curl -4 ifconfig.me)
EXPECTED_EGRESS_IP=203.0.113.10
EGRESS_CHECK_URL=https://api.ipify.org
EGRESS_CHECK_STRICT=true

# Torrentio manifest with Real Debrid token configured
STREMIO_ADDON_MANIFEST_URL=https://torrentio.strem.fun/realdebrid=YOUR_TOKEN/manifest.json

# Optional: explicit Real Debrid API token (falls back to token in manifest URL)
REAL_DEBRID_API_TOKEN=

# Host paths for completed downloads (mounted into the container)
DOWNLOAD_PATH_MOVIES=/mnt/user/media/Movies
DOWNLOAD_PATH_SERIES=/mnt/user/media/TV
# Legacy: if only DOWNLOAD_PATH is set, it is used as the movies path
# DOWNLOAD_PATH=/mnt/user/media/incoming

# Port for the Web UI (host publish and in-container listener)
WEB_PORT=8080
MAX_ACTIVE_DOWNLOADS=1
