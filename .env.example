# Tailscale (https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-xxxxxxxx
# VPS Tailscale IP (100.x.x.x from admin console) — required; short names like "regxa" fail at boot.
TS_EXIT_NODE=100.x.x.x
# compose sets TS_ACCEPT_DNS=false + 1.1.1.1/8.8.8.8 DNS on the sidecar if resolution fails

# VPS public WAN IP (run on VPS: curl -4 ifconfig.me)
# Leave empty to disable the egress check entirely (no exit node).
EXPECTED_EGRESS_IP=203.0.113.10
EGRESS_CHECK_URL=https://api.ipify.org
EGRESS_CHECK_STRICT=true
# Opt-in: overwrite /etc/resolv.conf with 1.1.1.1/8.8.8.8. Breaks Docker DNS
# for sibling services (e.g. addon-bridge), so leave off unless needed.
# PUBLIC_RESOLVERS=1

# Torrentio manifest with Real Debrid token configured
STREMIO_ADDON_MANIFEST_URL=https://torrentio.strem.fun/realdebrid=YOUR_TOKEN/manifest.json

# Optional: explicit Real Debrid API token (falls back to token in manifest URL)
REAL_DEBRID_API_TOKEN=

# Real-Debrid CDN — resolve panel links to nearest CDN, then pick fastest node.
# Pin a host to skip background scan (from speedtest output; .cloud vs .com matters):
# REAL_DEBRID_PREFERRED_CDN=45.download.real-debrid.cloud
# Background scan auto-picks fastest CDN host on egress path (default on):
# REAL_DEBRID_AUTO_SCAN=1
# REAL_DEBRID_SCAN_SECONDS=6.0
# REAL_DEBRID_SCAN_WORKERS=8
# REAL_DEBRID_SCAN_HOSTS=
# REAL_DEBRID_SCAN_TOP=20
# REAL_DEBRID_SCAN_CONNECT_TIMEOUT_SEC=8
# REAL_DEBRID_SCAN_CACHE_TTL_SEC=86400
# REAL_DEBRID_CONNECT_TIMEOUT_SEC=15
# REAL_DEBRID_READ_TIMEOUT_SEC=60
# REAL_DEBRID_API_BASE=https://api.real-debrid.com/rest/1.0
# REAL_DEBRID_REMOTE=0

# Host paths for completed downloads (mounted into the container)
DOWNLOAD_PATH_MOVIES=/mnt/user/media/Movies
DOWNLOAD_PATH_SERIES=/mnt/user/media/TV
# Legacy: if only DOWNLOAD_PATH is set, it is used as the movies path
# DOWNLOAD_PATH=/mnt/user/media/incoming

# Port for the Web UI (in-container listener; Caddy reverse_proxy target)
WEB_PORT=8080

# Docker network shared with Caddy (e.g. proxynet)
CADDY_NETWORK=proxynet

# Leave default unless addon-bridge runs elsewhere
# ADDON_BRIDGE_URL=http://addon-bridge:8090
MAX_ACTIVE_DOWNLOADS=1
